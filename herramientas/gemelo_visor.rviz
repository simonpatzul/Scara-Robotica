Panels: []
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Grid
      Cell Size: 0.05
      Plane Cell Count: 20
      Enabled: true
    - Class: rviz_default_plugins/RobotModel
      Name: SCARA
      Enabled: true
      Description Source: Topic
      Description Topic:
        Depth: 5
        Durability Policy: Transient Local
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /robot_description
      Visual Enabled: true
      Collision Enabled: false
    - Class: rviz_default_plugins/Marker
      Name: Bomba
      Enabled: true
      Topic:
        Value: /scara/bomba_marker
  Enabled: true
  Global Options:
    Fixed Frame: world
    Background Color: 48; 48; 48
    Frame Rate: 30
  Name: root
  Tools:
    - Class: rviz_default_plugins/Interact
  Value: true
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 0.95
      Focal Point:
        X: 0
        Y: -0.12
        Z: 0.06
      Name: Vista
      Pitch: 0.55
      Target Frame: <Fixed Frame>
      Value: Orbit (rviz)
      Yaw: 0.9
    Saved: ~
Window Geometry:
  Height: 860
  Width: 1400
  Hide Left Dock: true
  Hide Right Dock: true
  Displays:
    collapsed: true
  Views:
    collapsed: true
